# Based on https://github.com/ni/LabVIEW-CI-CD-Toolkit

FROM nationalinstruments/labview:2026q3-linux

USER root

ARG LABVIEW_VERSION=2026
ARG VIPM_DEB_URL=https://traffic.libsyn.com/secure/jkinc/vipm_26.3.0-3954_amd64.deb

ENV LABVIEW_PATH=/usr/local/natinst/LabVIEW-${LABVIEW_VERSION}-64/labview

# Activate server access
RUN echo "server.tcp.enabled=True" >> '/root/natinst/.config/LabVIEW-2026/labview.conf'

WORKDIR /workspace
RUN mkdir -p labview python python/test-report

# ------------------------------------------------------------
# Install uv
# ------------------------------------------------------------
RUN apt-get update; \
    apt-get install -y --no-install-recommends \
        curl; \
    curl -LsSf https://astral.sh/uv/install.sh | sh

# Add uv to PATH
ENV PATH="/root/.local/bin:$PATH"

# Check installation
RUN uv --version

# ------------------------------------------------------------
# Create python environment
# ------------------------------------------------------------
COPY python/pyproject.toml /opt/
RUN cd /opt; uv sync

# Add environment variable for py2vi
ENV py2vi_global_venv="/opt/.venv"
# ------------------------------------------------------------
# Install VIPM
# ------------------------------------------------------------
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        unzip \
        xvfb \
        fonts-dejavu-core \
        fonts-liberation \
        fonts-noto-core \
        xfonts-base \
        xfonts-75dpi \
        xfonts-100dpi \
        fontconfig; \
    fc-cache -f >/dev/null 2>&1 || true; \
    curl -fL --retry 3 --retry-delay 2 \
        -o /tmp/vipm.deb "${VIPM_DEB_URL}"; \
    dpkg -i /tmp/vipm.deb || \
        apt-get install -f -y --no-install-recommends; \
    rm -f /tmp/vipm.deb; \
    rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Install project dependencies
# ------------------------------------------------------------
COPY labview/py2vi.dragon /labview/project.dragon

RUN /bin/bash -c 'set -euo pipefail; \
    export VIPM_NONINTERACTIVE=1; \
    export VIPM_ASSUME_YES=1; \
    export NO_COLOR=1; \
    export VIPM_DEBUG=1; \
    export VIPM_TIMEOUT=900; \
    export VIPM_DESKTOP_LIVELINESS_TIMEOUT=900; \
    export CI=true; \
    \
    if [ -n "${LV_RTE_HEADLESS:-}" ]; then \
        echo "Clearing LV_RTE_HEADLESS for the VIPM install."; \
        unset LV_RTE_HEADLESS; \
    fi; \
    \
    export DISPLAY=:99; \
    if ! pgrep -x Xvfb >/dev/null 2>&1; then \
        Xvfb "$DISPLAY" \
            -screen 0 1280x720x24 \
            -ac \
            +extension GLX \
            +render \
            -noreset \
            >/tmp/xvfb.log 2>&1 & \
    fi; \
    \
    mkdir -p /tmp/natinst; \
    echo "1" > /tmp/natinst/LVContainer.txt; \
    \
    LABVIEW_BIN="/usr/local/natinst/LabVIEW-${LABVIEW_VERSION}-64/labview"; \
    echo "Starting LabVIEW headless: ${LABVIEW_BIN}"; \
    "${LABVIEW_BIN}" --headless \
        >/tmp/labview-headless.log 2>&1 & \
    \
    echo "Refreshing VIPM package sources..."; \
    vipm refresh --force; \
    \
    echo "Installing Dragon dependencies..."; \
    vipm \
        --show-progress \
        --verbose \
        --labview-version "${LABVIEW_VERSION}" \
        --labview-bitness 64 \
        install \
        /labview/project.dragon; \
    \
    vipm list --installed || true'

# Remove temporary Xvfb files left over from build
RUN rm -f /tmp/.X99-lock /tmp/.X11-unix/X99

# ------------------------------------------------------------
# Ready for mounted project
# ------------------------------------------------------------
